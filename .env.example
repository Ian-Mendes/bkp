POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://app:SENHA@db:5432/backup
# Fila (reservado; reintroduzir ao reativar Celery/Redis com o provider real)
# REDIS_URL=redis://redis:6379/0
# REDIS_PASSWORD=
JWT_SECRET=
TOKEN_MINUTES=60
REFRESH_DAYS=30            # validade do refresh token (cookie httpOnly); padrão 30
MAX_UPLOAD_MB=200
KEEP_UPLOADS=0
# Armazenamento em produção (volume local em dev; Vultr Object Storage, S3-compatível, na produção)
# S3_ENDPOINT_URL=https://<regiao>.vultrobjects.com
# S3_BUCKET=backup
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
RETENTION_DAYS=30
PROVIDER=null
APIFY_TOKEN=
APIFY_ACTOR_ID=apify/instagram-profile-scraper

# E-mail (dev: Mailpit capturando em http://localhost:8025)
FRONTEND_URL=http://localhost:3000
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=0
MAIL_FROM=BKP <no-reply@bkp.local>

# Segurança / produção
APP_ENV=development        # production: ativa HSTS e desativa /docs (a menos que ENABLE_DOCS=1)
ENABLE_DOCS=1              # 0 desativa /docs, /redoc e /openapi.json
UPLOADS_PER_HOUR=10        # envios de ZIP por usuário por hora
MAX_ORDERS_PER_USER=20     # pedidos guardados por usuário
